# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel
# (Project → Settings → Environment Variables).

# ── Navegador (públicas; o prefixo VITE_ as expõe ao site) ──────────────────
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# opcional: onde ficam as rotas /api (padrão: o próprio domínio)
# VITE_API_BASE=/api

# ── Servidor (secretas; NUNCA use prefixo VITE_ nelas) ──────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Bunny → Stream → sua biblioteca → API
BUNNY_LIBRARY_ID=123456
BUNNY_API_KEY=xxxxxxxx-xxxx-xxxx-xxxxxxxxxxxx-xxxx-xxxx
# Bunny → Stream → sua biblioteca → Security → Token authentication key (é diferente da API key)
BUNNY_TOKEN_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

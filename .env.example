# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel
# (Project → Settings → Environment Variables).

# ── Navegador (públicas; os prefixos VITE_ e NEXT_PUBLIC_ as expõem ao site) ──
# Supabase → Project Settings → API (a integração Supabase da Vercel já cria estas)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# opcional: onde ficam as rotas /api (padrão: o próprio domínio)
# VITE_API_BASE=/api

# ── Servidor (secretas; NUNCA use prefixo VITE_ ou NEXT_PUBLIC_ nelas) ──────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Bunny → Stream → sua biblioteca → API
BUNNY_LIBRARY_ID=123456
BUNNY_API_KEY=xxxxxxxx-xxxx-xxxx-xxxxxxxxxxxx-xxxx-xxxx
# Bunny → Stream → sua biblioteca → Security → Token authentication key (é diferente da API key)
BUNNY_TOKEN_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
